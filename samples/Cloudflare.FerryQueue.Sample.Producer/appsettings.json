{
  "CloudflareQueues": {
    "AccountId": "YOUR_ACCOUNT_ID",
    "ApiToken": "YOUR_API_TOKEN",
    "MaxRetries": 3,
    "RetryDelay": "00:00:00.250",
    "MaxRetryDelay": "00:00:10",
    "Timeout": "00:00:30"
  },
  "Producer": {
    "MessageCount": 2,
    "PublishIntervalMs": 3600
  },
  "Logging": {
    "LogLevel": {
      "Default":           "Information",
      "Cloudflare.FerryQueue": "Debug"
    }
  }
}
